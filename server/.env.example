PORT=5050
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_here
# Production rejects placeholders/short keys. Generate >=32 random bytes per key.
# Use independent JWT and GitHub encryption keys; never rotate encryption blindly.
# Exact frontend origins. Use one consistent hostname across client and API.
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
# Validate local URLs: npm run check:auth-config -- --local
# Production: NODE_ENV=production and one HTTPS origin; see docs/deployment-plan.md.
# Leave empty for direct/local access. Set only verified proxy IPs/CIDRs in deployment.
# Never set true, a hop count, or an all-address range. See docs/authentication.md.
TRUSTED_PROXY_CIDRS=

# Public self-signup: open or restricted. Restart the API after changes.
# Unset: open for development/test, restricted for production/unspecified NODE_ENV.
# Restricted closes new signup only; existing accounts can still log in.
# REGISTRATION_MODE=restricted

# GitHub OAuth app settings. Create these in GitHub Developer settings.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5050/api/v1/integrations/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=use_a_long_random_secret_for_encrypting_github_tokens

# Optional AI task drafting. Server-only; never use VITE_ for these values.
# Unset AI_ENABLED: true in development/test, false in production/unset NODE_ENV.
# Restart all API instances after changes. false stops new AI provider calls.
# AI_ENABLED=false
# Shared MongoDB-backed allowance for drafts + summaries, resetting at midnight UTC.
# Counts attempts including errors/timeouts. Request cap, NOT a dollar budget.
AI_DAILY_REQUEST_LIMIT=100
OPENAI_API_KEY=
# Choose a Responses API model supporting strict JSON-schema outputs.
OPENAI_TASK_DRAFT_MODEL=
